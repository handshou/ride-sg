# PostgreSQL Configuration
# Local default from compose.yaml; replace with any provider's PostgreSQL URL later.
DATABASE_URL=postgresql://ride_sg:ride_sg@127.0.0.1:54329/ride_sg

# Mapbox Configuration
# Get your access token from: https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here

# OpenAI Configuration (for Vision API image analysis)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
